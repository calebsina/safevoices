APP_NAME=SafeVoice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Default & fallback locale (must exist in the `locales` table)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=safevoice
DB_USERNAME=safevoice
DB_PASSWORD=secret

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# tymon/jwt-auth -- generate with `php artisan jwt:secret`
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Evidence vault (private, encrypted-at-application-layer disk)
EVIDENCE_DISK=evidence
EVIDENCE_MAX_KB=25600

# Follow-up (case code + PIN) brute-force protection
FOLLOWUP_MAX_ATTEMPTS=5
FOLLOWUP_DECAY_SECONDS=300

# WhatsApp / SMS gateway credentials (integration point - see NotificationService)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
